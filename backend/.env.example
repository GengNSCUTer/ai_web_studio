APP_NAME=ai_web_studio_backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=32007
CORS_ALLOWED_ORIGINS=http://127.0.0.1:32008,http://localhost:32008

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=35433
POSTGRES_DB=ai_web_studio
POSTGRES_USER=ligengnan
POSTGRES_PASSWORD=

OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_DEFAULT_MODEL=qwen3.5:27b-q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
CHAT_FIRST_TOKEN_TIMEOUT_SECONDS=120
CHAT_STREAM_IDLE_TIMEOUT_SECONDS=120
CHAT_STREAM_TOTAL_TIMEOUT_SECONDS=900

AUTH_SECRET_KEY=change-this-to-a-long-random-string
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

UPLOAD_DIR=/disk2/gengnan/ai_web_studio/backend/uploads
KNOWLEDGE_MODEL_REQUEST_TIMEOUT_SECONDS=60
KNOWLEDGE_CONTEXT_TIMEOUT_SECONDS=25
KNOWLEDGE_REDIS_URL=redis://127.0.0.1:36379/0
KNOWLEDGE_JOB_STREAM=stream.aiws.knowledge-jobs
KNOWLEDGE_JOB_GROUP=aiws-knowledge-workers

TAVILY_API_KEY=
AMAP_API_KEY=
EXTERNAL_TOOL_TIMEOUT_SECONDS=8
MCP_MAX_RESPONSE_BYTES=1048576
# 公网/多用户部署保持 false；只有可信本地单用户需要连接 localhost/private MCP 时才开启。
ALLOW_PRIVATE_MCP_SERVERS=false
