    {"case_id":"redis_08","query":"Redis 企业实战资料中，如何处理锁释放时的所有者校验？","expected_chunk_selectors":[{"document_file":"02-Redis企业实战.md","chunk_index":2,"contains":"线程标示"}],"expected_answer_keywords":["一致","删除"]},
