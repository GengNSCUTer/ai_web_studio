{
  "schema_version": 3,
  "name": "rag_gold_v3_multi_evidence_20_case",
  "description": "个人论文知识库 RAG 固定评测集。20 个 Case 均由人工设计问题，并绑定 3 个可审计的正确 Chunk；expected_document_files 由 Chunk selector 自动补齐。",
  "labeling_policy": {
    "primary_target": "expected_chunk_selectors",
    "selector": "document_file + chunk_index，必要时可再提供 contains 做内容校验",
    "fallback_target": "expected_document_files",
    "answer_signal": "expected_answer_keywords",
    "notes": "Chunk 目标用于 Context Recall / nDCG；文档目标用于索引重建后 Chunk 引用失效时的稳定回退。Hit@K 表示至少命中一个目标，Context Recall 表示命中的不同目标占全部人工目标的比例。"
  },
  "cases": [
    {
